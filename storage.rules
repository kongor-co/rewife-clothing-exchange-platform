rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVerified() {
      return request.auth != null
        ? request.auth.token.email_verified == true
        : false;
    }

    function memberIsActive() {
      return isVerified()
        ? firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE'
          : false
        : false;
    }

    function itemPath(itemId) {
      return /databases/(default)/documents/clothingItems/$(itemId);
    }

    function itemExists(itemId) {
      return firestore.exists(itemPath(itemId));
    }

    function requesterOwnsItem(itemId) {
      return firestore.exists(itemPath(itemId))
        ? request.auth != null
          ? firestore.get(itemPath(itemId)).data.ownerId == request.auth.uid
          : false
        : false;
    }

    function itemAcceptsUpload(itemId) {
      return firestore.get(itemPath(itemId)).data.status in ['DRAFT', 'AVAILABLE'];
    }

    function validImage(fileName) {
      return fileName.matches('photo-[0-4]')
        ? request.resource.size > 0
          ? request.resource.size <= 3 * 1024 * 1024
            ? request.resource.contentType.matches('image/(jpeg|png|webp)')
            : false
          : false
        : false;
    }

    function imageBelongsToItem(uid, itemId, fileName) {
      return itemExists(itemId)
        ? firestore.get(itemPath(itemId)).data.imagePaths is list
          ? 'itemImages/' + uid + '/' + itemId + '/' + fileName in firestore.get(itemPath(itemId)).data.imagePaths
          : false
        : false;
    }

    function exchangeAllowsRead(exchangeId) {
      return request.auth != null
        ? exchangeId is string
          ? firestore.exists(/databases/(default)/documents/exchanges/$(exchangeId))
            ? firestore.get(/databases/(default)/documents/exchanges/$(exchangeId)).data.contributorId == request.auth.uid ||
              firestore.get(/databases/(default)/documents/exchanges/$(exchangeId)).data.claimantId == request.auth.uid
            : false
          : false
        : false;
    }

    function previousExchangeAllowsRead(itemData) {
      return 'previousExchangeId' in itemData
        ? itemData.previousExchangeId is string
          ? firestore.exists(/databases/(default)/documents/exchanges/$(itemData.previousExchangeId))
            ? firestore.get(/databases/(default)/documents/exchanges/$(itemData.previousExchangeId)).data.status == 'COMPLETED'
              ? exchangeAllowsRead(itemData.previousExchangeId)
              : false
            : false
          : false
        : false;
    }

    function canReadItemImage(uid, itemId, fileName) {
      return imageBelongsToItem(uid, itemId, fileName)
        ? firestore.get(itemPath(itemId)).data.status == 'AVAILABLE'
          ? true
          : memberIsActive()
            ? requesterOwnsItem(itemId) ||
              exchangeAllowsRead(firestore.get(itemPath(itemId)).data.activeExchangeId) ||
              previousExchangeAllowsRead(firestore.get(itemPath(itemId)).data)
            : false
        : false;
    }

    match /itemImages/{uid}/{itemId}/{fileName} {
      allow read: if canReadItemImage(uid, itemId, fileName);
      allow create: if memberIsActive()
        ? request.auth.uid == uid
          ? requesterOwnsItem(itemId)
            ? itemAcceptsUpload(itemId)
              ? validImage(fileName)
              : false
            : false
          : false
        : false;
      allow delete: if memberIsActive()
        ? requesterOwnsItem(itemId)
          ? itemAcceptsUpload(itemId)
            ? imageBelongsToItem(uid, itemId, fileName)
            : false
          : false
        : false;
      allow update: if memberIsActive()
        ? requesterOwnsItem(itemId)
          ? itemAcceptsUpload(itemId)
            ? imageBelongsToItem(uid, itemId, fileName)
              ? validImage(fileName)
              : false
            : false
          : false
        : false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
